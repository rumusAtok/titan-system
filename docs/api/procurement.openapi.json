        ]
      }
    },
    "/rfqs/{id}/quotations": {
      "post": {
        "operationId": "SourcingController_quote",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "currency": {
                    "default": "USD",
                    "pattern": "^[A-Z]{3}$",
                    "type": "string"
                  },
                  "lead_time_days": {
                    "default": null,
                    "maximum": 3650,
                    "minimum": 0,
                    "nullable": true,
                    "type": "integer"
                  },
                  "lines": {
                    "items": {
                      "properties": {
                        "line_no": {
                          "exclusiveMinimum": true,
                          "maximum": 9007199254740991,
                          "minimum": 0,
                          "type": "integer"
                        },
                        "unit_cost": {
                          "maximum": 10000000,
                          "minimum": 0,
                          "type": "number"
                        }
                      },
                      "required": [
                        "line_no",
                        "unit_cost"
                      ],
                      "type": "object"
                    },
                    "maxItems": 50,
                    "minItems": 1,
                    "type": "array"
                  },
                  "note": {
                    "default": "",
                    "maxLength": 1000,
                    "type": "string"
                  },
                  "supplier_code": {
                    "pattern": "^[A-Z0-9][A-Z0-9_-]{1,31}$",
                    "type": "string"
                  },
                  "valid_until": {
                    "default": null,
                    "nullable": true,
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                    "type": "string"
                  }
                },
                "required": [
                  "supplier_code",
                  "lines"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Record a quotation received from an invited supplier",
        "tags": [
          "procurement-sourcing"
        ]
      }
    },
    "/stock/adjust": {
      "post": {
        "operationId": "ProcurementController_adjust",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "counted": {
                    "maximum": 1000000,
                    "minimum": 0,
                    "type": "number"
                  },
                  "location": {
                    "pattern": "^[A-Z0-9][A-Z0-9_-]{1,31}$",
                    "type": "string"
                  },
                  "note": {
                    "maxLength": 500,
                    "minLength": 3,
                    "type": "string"
                  },
                  "sku": {
                    "maxLength": 41,
                    "minLength": 2,
                    "type": "string"
                  }
                },
                "required": [
                  "sku",
                  "location",
                  "counted",
                  "note"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Record a stock count; the difference is booked as an adjustment",
        "tags": [
          "procurement"
        ]
      }
    },
    "/stock/issue": {
      "post": {
        "operationId": "ProcurementController_issue",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "location": {
                    "pattern": "^[A-Z0-9][A-Z0-9_-]{1,31}$",
                    "type": "string"
                  },
                  "note": {
                    "default": "",
                    "maxLength": 500,
                    "type": "string"
                  },
                  "quantity": {
                    "exclusiveMinimum": true,
                    "maximum": 1000000,
                    "minimum": 0,
                    "type": "number"
                  },
                  "reference_id": {
                    "default": null,
                    "maxLength": 100,
                    "nullable": true,
                    "type": "string"
                  },
                  "reference_type": {
                    "default": "other",
                    "enum": [
                      "work_order",
                      "maintenance_request",
                      "other"
                    ],
                    "type": "string"
                  },
                  "sku": {
                    "maxLength": 41,
                    "minLength": 2,
                    "type": "string"
                  }
                },
                "required": [
                  "sku",
                  "location",
                  "quantity"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Issue stock (e.g. to a work order). At or below the reorder level a replenishment request is raised",
        "tags": [
          "procurement"
        ]
      }
    },
    "/summary": {
      "get": {
        "operationId": "ProcurementController_summary",
