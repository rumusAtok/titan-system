    "/rfqs/{id}/award": {
      "post": {
        "operationId": "SourcingController_award",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "quotation_id": {
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                    "type": "string"
                  },
                  "reason": {
                    "default": "",
                    "maxLength": 1000,
                    "type": "string"
                  }
                },
                "required": [
                  "quotation_id"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Award a quotation: it becomes a purchase request (normal approval); a non-lowest award needs a reason",
        "tags": [
          "procurement-sourcing"
        ]
      }
    },
    "/rfqs/{id}/cancel": {
      "post": {
        "operationId": "SourcingController_cancelRfq",
        "parameters": [],
