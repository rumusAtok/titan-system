  "openapi": "3.0.0",
  "paths": {
    "/cost-centres": {
      "get": {
        "operationId": "SourcingController_costCentres",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Cost centres with this year's budget, committed spend and what is left",
        "tags": [
          "procurement-sourcing"
        ]
      },
      "post": {
        "operationId": "SourcingController_createCostCentre",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "code": {
                    "pattern": "^[A-Z0-9][A-Z0-9_-]{1,31}$",
                    "type": "string"
                  },
                  "name": {
                    "maxLength": 200,
                    "minLength": 2,
                    "type": "string"
                  }
                },
                "required": [
                  "code",
                  "name"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "procurement-sourcing"
        ]
      }
    },
    "/cost-centres/{code}/budget": {
      "put": {
        "operationId": "SourcingController_setBudget",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "amount": {
                    "maximum": 1000000000,
                    "minimum": 0,
                    "type": "number"
                  },
                  "currency": {
                    "default": "USD",
                    "pattern": "^[A-Z]{3}$",
                    "type": "string"
                  },
                  "year": {
                    "maximum": 2100,
                    "minimum": 2000,
                    "type": "integer"
                  }
                },
                "required": [
                  "year",
                  "amount"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Set the budget of a cost centre for a year (tenant administrator or budget holder)",
        "tags": [
          "procurement-sourcing"
        ]
      }
    },
    "/items": {
      "get": {
        "operationId": "ProcurementController_items",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Stock items with stock on hand per location",
        "tags": [
          "procurement"
        ]
      },
      "post": {
        "operationId": "ProcurementController_createItem",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "category": {
                    "default": "general",
                    "maxLength": 60,
                    "minLength": 2,
                    "type": "string"
                  },
                  "currency": {
                    "default": "USD",
                    "pattern": "^[A-Z]{3}$",
                    "type": "string"
                  },
                  "name": {
                    "maxLength": 200,
                    "minLength": 2,
                    "type": "string"
                  },
                  "preferred_supplier_code": {
                    "default": null,
                    "nullable": true,
                    "pattern": "^[A-Z0-9][A-Z0-9_-]{1,31}$",
                    "type": "string"
                  },
                  "reorder_level": {
                    "default": 0,
                    "maximum": 1000000,
                    "minimum": 0,
                    "type": "number"
                  },
                  "reorder_quantity": {
                    "default": 0,
                    "maximum": 1000000,
                    "minimum": 0,
                    "type": "number"
                  },
                  "sku": {
                    "pattern": "^[A-Z0-9][A-Z0-9_-]{1,40}$",
                    "type": "string"
                  },
                  "unit": {
                    "default": "each",
                    "maxLength": 20,
                    "minLength": 1,
                    "type": "string"
                  },
                  "unit_cost": {
                    "maximum": 10000000,
                    "minimum": 0,
                    "type": "number"
                  }
                },
                "required": [
                  "sku",
                  "name",
                  "unit_cost"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "procurement"
        ]
      }
    },
