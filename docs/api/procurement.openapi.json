    "/suppliers": {
      "get": {
        "operationId": "ProcurementController_suppliers",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "procurement"
        ]
      },
      "post": {
        "operationId": "ProcurementController_createSupplier",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "code": {
                    "pattern": "^[A-Z0-9][A-Z0-9_-]{1,31}$",
                    "type": "string"
                  },
                  "contact_email": {
                    "default": null,
                    "format": "email",
                    "maxLength": 254,
                    "nullable": true,
                    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
                    "type": "string"
                  },
                  "name": {
                    "maxLength": 200,
                    "minLength": 2,
                    "type": "string"
                  },
                  "phone": {
                    "default": null,
                    "maxLength": 40,
                    "nullable": true,
                    "type": "string"
                  }
                },
                "required": [
                  "code",
                  "name"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "procurement"
        ]
      }
    }
  },
