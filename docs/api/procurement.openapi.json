    "/purchase-orders/{id}": {
      "get": {
        "operationId": "ProcurementController_getOrder",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "procurement"
        ]
      }
    },
    "/purchase-orders/{id}/receive": {
      "post": {
        "operationId": "ProcurementController_receive",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "lines": {
                    "items": {
                      "properties": {
                        "line_no": {
                          "exclusiveMinimum": true,
                          "maximum": 9007199254740991,
                          "minimum": 0,
                          "type": "integer"
                        },
                        "quantity": {
                          "exclusiveMinimum": true,
                          "minimum": 0,
                          "type": "number"
                        }
                      },
                      "required": [
                        "line_no",
                        "quantity"
                      ],
                      "type": "object"
                    },
                    "maxItems": 50,
                    "minItems": 1,
                    "type": "array"
                  },
                  "note": {
                    "default": "",
                    "maxLength": 1000,
                    "type": "string"
                  }
                },
                "required": [
                  "lines"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Record a goods receipt (partial or complete); stock increases at the delivery location",
        "tags": [
          "procurement"
        ]
      }
    },
    "/purchase-requests": {
      "get": {
        "operationId": "ProcurementController_requests",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "procurement"
        ]
      },
      "post": {
        "operationId": "ProcurementController_createRequest",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "cost_centre_code": {
                    "default": null,
                    "nullable": true,
                    "pattern": "^[A-Z0-9][A-Z0-9_-]{1,31}$",
                    "type": "string"
                  },
                  "delivery_location": {
                    "pattern": "^[A-Z0-9][A-Z0-9_-]{1,31}$",
                    "type": "string"
                  },
                  "justification": {
                    "default": "",
                    "maxLength": 4000,
                    "type": "string"
                  },
                  "lines": {
                    "items": {
                      "properties": {
                        "quantity": {
                          "exclusiveMinimum": true,
                          "maximum": 1000000,
                          "minimum": 0,
                          "type": "number"
                        },
                        "sku": {
                          "maxLength": 41,
                          "minLength": 2,
                          "type": "string"
                        },
                        "unit_cost": {
                          "maximum": 10000000,
                          "minimum": 0,
                          "type": "number"
                        }
                      },
                      "required": [
                        "sku",
                        "quantity"
                      ],
                      "type": "object"
                    },
                    "maxItems": 50,
                    "minItems": 1,
                    "type": "array"
                  },
                  "supplier_code": {
                    "pattern": "^[A-Z0-9][A-Z0-9_-]{1,31}$",
                    "type": "string"
                  },
                  "title": {
                    "maxLength": 200,
                    "minLength": 3,
                    "type": "string"
                  },
                  "work_order_id": {
                    "default": null,
                    "format": "uuid",
                    "nullable": true,
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                    "type": "string"
                  }
                },
                "required": [
                  "title",
                  "supplier_code",
                  "delivery_location",
                  "lines"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Raise a purchase request; it goes to the purchase-approval workflow, and approval issues a purchase order",
        "tags": [
          "procurement"
        ]
      }
    },
    "/purchase-requests/{id}": {
      "get": {
        "operationId": "ProcurementController_getRequest",
