    "/rfqs": {
      "get": {
        "operationId": "SourcingController_rfqs",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "procurement-sourcing"
        ]
      },
      "post": {
        "operationId": "SourcingController_createRfq",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "cost_centre_code": {
                    "default": null,
                    "nullable": true,
                    "pattern": "^[A-Z0-9][A-Z0-9_-]{1,31}$",
                    "type": "string"
                  },
                  "delivery_location": {
                    "pattern": "^[A-Z0-9][A-Z0-9_-]{1,31}$",
                    "type": "string"
                  },
                  "lines": {
                    "items": {
                      "properties": {
                        "quantity": {
                          "exclusiveMinimum": true,
                          "maximum": 1000000,
                          "minimum": 0,
                          "type": "number"
                        },
                        "sku": {
                          "maxLength": 41,
                          "minLength": 2,
                          "type": "string"
                        }
                      },
                      "required": [
                        "sku",
                        "quantity"
                      ],
                      "type": "object"
                    },
                    "maxItems": 50,
                    "minItems": 1,
                    "type": "array"
                  },
                  "respond_by": {
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                    "type": "string"
                  },
                  "supplier_codes": {
                    "items": {
                      "pattern": "^[A-Z0-9][A-Z0-9_-]{1,31}$",
                      "type": "string"
                    },
                    "maxItems": 20,
                    "minItems": 1,
                    "type": "array"
                  },
                  "title": {
                    "maxLength": 200,
                    "minLength": 3,
                    "type": "string"
                  }
                },
                "required": [
                  "title",
                  "delivery_location",
                  "respond_by",
                  "lines",
                  "supplier_codes"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Request for quotation: items, quantities and invited suppliers (nobody is contacted by TITAN)",
        "tags": [
          "procurement-sourcing"
        ]
      }
    },
    "/rfqs/{id}": {
      "get": {
        "operationId": "SourcingController_rfq",
