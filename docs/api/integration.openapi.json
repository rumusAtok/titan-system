        ]
      }
    },
    "/endpoints": {
      "get": {
        "operationId": "IntegrationController_endpoints",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "integrations"
        ]
      },
      "post": {
        "operationId": "IntegrationController_createEndpoint",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "default_category": {
                    "default": null,
                    "nullable": true,
                    "pattern": "^[a-z][a-z0-9-]{1,62}$",
                    "type": "string"
                  },
                  "default_severity": {
                    "default": "warning",
                    "enum": [
                      "info",
                      "warning",
                      "critical"
                    ],
                    "type": "string"
                  },
                  "name": {
                    "maxLength": 120,
                    "minLength": 3,
                    "type": "string"
                  }
                },
                "required": [
                  "name"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Create an inbound incident endpoint. The signing secret is returned once",
        "tags": [
          "integrations"
        ]
      }
    },
    "/endpoints/{id}": {
      "patch": {
        "operationId": "IntegrationController_setActive",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "active": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "active"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "integrations"
        ]
      }
    },
    "/endpoints/{id}/messages": {
      "get": {
        "operationId": "IntegrationController_messages",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Requests received on an endpoint: accepted, duplicate and rejected (with reason)",
        "tags": [
          "integrations"
        ]
      }
    },
    "/endpoints/{id}/rotate-secret": {
      "post": {
        "operationId": "IntegrationController_rotate",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
