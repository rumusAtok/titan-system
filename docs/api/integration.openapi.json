    "/subscriptions": {
      "get": {
        "operationId": "IntegrationController_subscriptions",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "integrations"
        ]
      },
      "post": {
        "operationId": "IntegrationController_createSubscription",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "event_types": {
                    "items": {
                      "enum": [
                        "incident.created.v1",
                        "incident.acknowledged.v1",
                        "incident.resolved.v1",
                        "alert.raised.v1",
                        "alert.cleared.v1",
                        "maintenance.work_order.created.v1",
                        "maintenance.work_order.completed.v1",
                        "procurement.purchase_order.issued.v1",
                        "procurement.goods.received.v1",
                        "procurement.stock.low.v1",
                        "document.version.published.v1",
                        "report.generated.v1",
                        "geo.incident.in_zone.v1",
                        "video.marker.created.v1"
                      ],
                      "type": "string"
                    },
                    "maxItems": 14,
                    "minItems": 1,
                    "type": "array"
                  },
                  "name": {
                    "maxLength": 120,
                    "minLength": 3,
                    "type": "string"
                  },
                  "target_url": {
                    "maxLength": 500,
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "target_url",
                  "event_types"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Forward selected events to an allow-listed destination, signed. The signing secret is returned once",
        "tags": [
          "integrations"
        ]
      }
    },
    "/subscriptions/{id}": {
      "patch": {
        "operationId": "IntegrationController_updateSubscription",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "active": {
                    "type": "boolean"
                  },
                  "event_types": {
                    "items": {
                      "enum": [
                        "incident.created.v1",
                        "incident.acknowledged.v1",
                        "incident.resolved.v1",
                        "alert.raised.v1",
                        "alert.cleared.v1",
                        "maintenance.work_order.created.v1",
                        "maintenance.work_order.completed.v1",
                        "procurement.purchase_order.issued.v1",
                        "procurement.goods.received.v1",
                        "procurement.stock.low.v1",
                        "document.version.published.v1",
                        "report.generated.v1",
                        "geo.incident.in_zone.v1",
                        "video.marker.created.v1"
                      ],
                      "type": "string"
                    },
                    "maxItems": 14,
                    "minItems": 1,
                    "type": "array"
                  },
                  "expected_version": {
                    "exclusiveMinimum": true,
                    "maximum": 9007199254740991,
                    "minimum": 0,
                    "type": "integer"
                  }
                },
                "required": [
                  "expected_version"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "integrations"
        ]
      }
    },
    "/subscriptions/{id}/deliveries": {
      "get": {
        "operationId": "IntegrationController_deliveries",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "integrations"
        ]
      }
    }
  },
