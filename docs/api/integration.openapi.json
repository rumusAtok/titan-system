      }
    }
  },
  "info": {
    "contact": {},
    "description": "Signed inbound webhooks that report incidents, and outbound event subscriptions delivered (signed, with retries) to allow-listed destinations only.",
    "title": "TITAN integration-service",
    "version": "0.1.0"
  },
  "openapi": "3.0.0",
  "paths": {
    "/catalogue": {
      "get": {
        "operationId": "IntegrationController_catalogue",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Event types that can be forwarded, destination hosts on the allow-list, and the signature scheme",
        "tags": [
          "integrations"
        ]
      }
    },
    "/deliveries/{id}/retry": {
      "post": {
        "operationId": "IntegrationController_retry",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
