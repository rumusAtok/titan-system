              "schema": {
                "properties": {
                  "data": {
                    "additionalProperties": {},
                    "default": {},
                    "type": "object"
                  },
                  "form_key": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "title": {
                    "maxLength": 200,
                    "minLength": 3,
                    "type": "string"
                  }
                },
                "required": [
