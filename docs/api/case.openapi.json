    "/forms": {
      "get": {
        "operationId": "CaseController_listForms",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Active application forms",
        "tags": [
          "cases"
        ]
      },
      "post": {
        "operationId": "CaseController_createForm",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "description": {
                    "default": "",
                    "maxLength": 2000,
                    "type": "string"
                  },
                  "fields": {
                    "items": {
                      "properties": {
                        "help": {
                          "maxLength": 500,
                          "type": "string"
                        },
                        "label": {
                          "maxLength": 200,
                          "minLength": 1,
                          "type": "string"
                        },
                        "max": {
                          "type": "number"
                        },
                        "max_length": {
                          "exclusiveMinimum": true,
                          "maximum": 10000,
                          "minimum": 0,
                          "type": "integer"
                        },
                        "min": {
                          "type": "number"
                        },
                        "name": {
                          "pattern": "^[a-z][a-z0-9_]{0,62}$",
                          "type": "string"
                        },
                        "options": {
                          "items": {
                            "minLength": 1,
                            "type": "string"
                          },
                          "minItems": 1,
                          "type": "array"
                        },
                        "required": {
                          "default": false,
                          "type": "boolean"
                        },
                        "type": {
                          "enum": [
                            "text",
                            "textarea",
                            "number",
                            "date",
                            "select",
                            "boolean",
                            "email"
                          ],
                          "type": "string"
                        }
                      },
                      "required": [
                        "name",
                        "label",
                        "type"
                      ],
                      "type": "object"
                    },
                    "maxItems": 100,
                    "minItems": 1,
                    "type": "array"
                  },
                  "key": {
                    "pattern": "^[a-z0-9][a-z0-9-]{1,62}$",
                    "type": "string"
                  },
                  "title": {
                    "maxLength": 200,
                    "minLength": 2,
                    "type": "string"
                  },
                  "workflow_key": {
                    "maxLength": 64,
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "key",
                  "title",
                  "workflow_key",
                  "fields"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Publish a new version of a form",
        "tags": [
