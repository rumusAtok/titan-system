      "patch": {
        "operationId": "CaseController_update",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "data": {
                    "additionalProperties": {},
                    "type": "object"
                  },
                  "expected_version": {
                    "exclusiveMinimum": true,
                    "maximum": 9007199254740991,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "title": {
                    "maxLength": 200,
                    "minLength": 3,
                    "type": "string"
                  }
                },
                "required": [
                  "expected_version"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Edit a draft or returned case (optimistic concurrency via expected_version)",
        "tags": [
          "cases"
        ]
      }
    },
    "/cases/{id}/attachments": {
      "post": {
        "operationId": "CaseController_addAttachment",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "content_base64": {
                    "maxLength": 3000000,
                    "minLength": 1,
                    "type": "string"
                  },
                  "content_type": {
                    "maxLength": 100,
                    "minLength": 1,
                    "type": "string"
                  },
                  "filename": {
                    "maxLength": 255,
                    "minLength": 1,
                    "type": "string"
                  }
                },
