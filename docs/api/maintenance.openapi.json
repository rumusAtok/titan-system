{
  "components": {
    "schemas": {},
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "Maintenance and service requests, their approval outcome and work orders. Request types are installed by industry packs; approval is decided by the workflow each request type names.",
    "title": "TITAN maintenance-service",
    "version": "0.1.0"
  },
  "openapi": "3.0.0",
  "paths": {
    "/request-types": {
      "get": {
        "operationId": "MaintenanceController_requestTypes",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Kinds of request the tenant can raise, their detail fields, and whether the caller may raise them",
        "tags": [
          "maintenance"
        ]
      }
    },
    "/requests": {
      "get": {
        "operationId": "MaintenanceController_listRequests",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Maintenance and service requests. Staff see all of the tenant; other users only their own.",
        "tags": [
          "maintenance"
        ]
      },
      "post": {
        "description": "The caller needs one of the request type's requester roles. The request goes to the approval workflow the type names; approval creates a work order.",
        "operationId": "MaintenanceController_createRequest",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "asset_id": {
                    "default": null,
                    "format": "uuid",
                    "nullable": true,
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                    "type": "string"
                  },
                  "description": {
                    "default": "",
                    "maxLength": 4000,
                    "type": "string"
                  },
                  "details": {
                    "additionalProperties": {},
                    "default": {},
                    "type": "object"
                  },
                  "priority": {
                    "enum": [
                      "low",
                      "normal",
                      "high",
                      "urgent"
                    ],
                    "type": "string"
                  },
                  "request_type": {
                    "pattern": "^[a-z][a-z0-9-]{1,62}$",
                    "type": "string"
                  },
                  "title": {
                    "maxLength": 200,
                    "minLength": 3,
                    "type": "string"
                  }
                },
                "required": [
                  "request_type",
                  "title"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Raise a maintenance or service request",
        "tags": [
          "maintenance"
        ]
      }
    },
    "/requests/{id}": {
      "get": {
        "operationId": "MaintenanceController_getRequest",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "maintenance"
        ]
      }
    },
    "/requests/{id}/cancel": {
      "post": {
        "operationId": "MaintenanceController_cancelRequest",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Withdraw a request that has not been decided (requester or planner)",
        "tags": [
          "maintenance"
        ]
      }
    },
    "/summary": {
      "get": {
        "operationId": "MaintenanceController_summary",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Request and work order counts by industry pack and status, and completed-work turnaround",
        "tags": [
          "maintenance"
        ]
      }
    },
    "/work-orders": {
      "get": {
        "operationId": "MaintenanceController_listWorkOrders",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Work orders; status=active returns open, assigned and in-progress orders; mine=true only the caller's",
        "tags": [
          "maintenance"
        ]
      }
    },
    "/work-orders/{id}": {
      "get": {
        "operationId": "MaintenanceController_getWorkOrder",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "maintenance"
        ]
      }
    },
    "/work-orders/{id}/assign": {
      "post": {
        "operationId": "MaintenanceController_assign",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "assignee_id": {
                    "maxLength": 100,
                    "minLength": 1,
                    "type": "string"
                  },
                  "assignee_username": {
                    "maxLength": 255,
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "assignee_id",
                  "assignee_username"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Assign (or, before work starts, re-assign) a work order",
        "tags": [
          "maintenance"
        ]
      }
    },
    "/work-orders/{id}/cancel": {
      "post": {
        "operationId": "MaintenanceController_cancelWorkOrder",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "reason": {
                    "maxLength": 1000,
                    "minLength": 3,
                    "type": "string"
                  }
                },
                "required": [
                  "reason"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "maintenance"
        ]
      }
    },
    "/work-orders/{id}/complete": {
      "post": {
        "operationId": "MaintenanceController_complete",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "condition_after": {
                    "default": null,
                    "enum": [
                      "good",
                      "fair",
                      "poor",
                      "critical"
                    ],
                    "nullable": true,
                    "type": "string"
                  },
                  "labor_hours": {
                    "default": null,
                    "maximum": 10000,
                    "minimum": 0,
                    "nullable": true,
                    "type": "number"
                  },
                  "summary": {
                    "maxLength": 4000,
                    "minLength": 3,
                    "type": "string"
                  }
                },
                "required": [
                  "summary"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Complete work with a summary, labour hours and the asset's condition (the assigned technician, or a planner)",
        "tags": [
          "maintenance"
        ]
      }
    },
    "/work-orders/{id}/start": {
      "post": {
        "operationId": "MaintenanceController_start",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Start work (the assigned technician, or a planner)",
        "tags": [
          "maintenance"
        ]
      }
    }
  },
  "security": [
    {
      "bearer": []
    }
  ],
  "servers": [],
  "tags": []
}
