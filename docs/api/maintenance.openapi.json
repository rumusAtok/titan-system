                        "quantity"
                      ],
                      "type": "object"
                    },
                    "maxItems": 30,
                    "type": "array"
                  },
                  "summary": {
                    "maxLength": 4000,
                    "minLength": 3,
                    "type": "string"
                  }
                },
                "required": [
                  "summary"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
