        "operationId": "MaintenanceController_complete",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "condition_after": {
                    "default": null,
                    "enum": [
                      "good",
                      "fair",
                      "poor",
                      "critical"
                    ],
                    "nullable": true,
                    "type": "string"
                  },
                  "labor_hours": {
                    "default": null,
                    "maximum": 10000,
                    "minimum": 0,
                    "nullable": true,
                    "type": "number"
                  },
                  "parts": {
                    "default": [],
                    "items": {
                      "properties": {
                        "location": {
                          "pattern": "^[A-Z0-9][A-Z0-9_-]{1,31}$",
                          "type": "string"
                        },
                        "quantity": {
                          "exclusiveMinimum": true,
                          "maximum": 100000,
                          "minimum": 0,
