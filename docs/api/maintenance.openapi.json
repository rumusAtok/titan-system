{
  "components": {
    "schemas": {},
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "Maintenance and service requests, their approval outcome and work orders. Request types are installed by industry packs; approval is decided by the workflow each request type names.",
    "title": "TITAN maintenance-service",
    "version": "0.1.0"
  },
  "openapi": "3.0.0",
  "paths": {
    "/planning/inspection-plans": {
      "get": {
        "operationId": "PlanningController_inspectionPlans",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "maintenance-planning"
        ]
      },
      "post": {
        "operationId": "PlanningController_createInspection",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "asset_id": {
                    "default": null,
                    "format": "uuid",
                    "nullable": true,
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                    "type": "string"
                  },
                  "assigned_role": {
                    "pattern": "^[a-z][a-z0-9_]{1,62}$",
                    "type": "string"
                  },
                  "checklist": {
                    "items": {
                      "properties": {
                        "key": {
                          "pattern": "^[a-z][a-z0-9_]{0,40}$",
                          "type": "string"
                        },
                        "kind": {
                          "enum": [
                            "pass_fail",
                            "number"
                          ],
                          "type": "string"
                        },
                        "max": {
                          "type": "number"
                        },
                        "min": {
                          "type": "number"
                        },
                        "question": {
                          "maxLength": 200,
                          "minLength": 3,
                          "type": "string"
                        },
                        "unit": {
                          "maxLength": 20,
                          "type": "string"
                        }
                      },
                      "required": [
                        "key",
                        "question",
                        "kind"
                      ],
                      "type": "object"
                    },
                    "maxItems": 60,
                    "minItems": 1,
                    "type": "array"
                  },
                  "code": {
                    "pattern": "^[A-Z0-9][A-Z0-9_-]{1,31}$",
                    "type": "string"
                  },
                  "finding_request_type": {
                    "pattern": "^[a-z][a-z0-9-]{1,62}$",
                    "type": "string"
                  },
                  "interval_days": {
                    "maximum": 3650,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "location": {
                    "default": "",
                    "maxLength": 200,
                    "type": "string"
                  },
                  "name": {
                    "maxLength": 200,
                    "minLength": 3,
                    "type": "string"
                  },
                  "next_due_on": {
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                    "type": "string"
                  }
                },
                "required": [
                  "code",
                  "name",
                  "checklist",
                  "interval_days",
                  "next_due_on",
                  "assigned_role",
                  "finding_request_type"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "maintenance-planning"
        ]
      }
    },
