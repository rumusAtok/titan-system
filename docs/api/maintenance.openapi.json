      "post": {
        "description": "The caller needs one of the request type's requester roles. The request goes to the approval workflow the type names; approval creates a work order.",
        "operationId": "MaintenanceController_createRequest",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "asset_id": {
                    "default": null,
                    "format": "uuid",
                    "nullable": true,
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                    "type": "string"
                  },
                  "description": {
                    "default": "",
                    "maxLength": 4000,
                    "type": "string"
                  },
                  "details": {
                    "additionalProperties": {},
                    "default": {},
                    "type": "object"
                  },
                  "priority": {
                    "enum": [
                      "low",
                      "normal",
                      "high",
                      "urgent"
                    ],
                    "type": "string"
                  },
                  "request_type": {
                    "pattern": "^[a-z][a-z0-9-]{1,62}$",
                    "type": "string"
                  },
                  "title": {
                    "maxLength": 200,
                    "minLength": 3,
                    "type": "string"
                  }
                },
                "required": [
                  "request_type",
                  "title"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Raise a maintenance or service request",
        "tags": [
