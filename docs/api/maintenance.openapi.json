      "post": {
        "operationId": "PlanningController_createPm",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "asset_id": {
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                    "type": "string"
                  },
                  "checklist": {
                    "default": [],
                    "items": {
                      "maxLength": 200,
                      "minLength": 2,
                      "type": "string"
                    },
                    "maxItems": 40,
                    "type": "array"
                  },
                  "code": {
                    "pattern": "^[A-Z0-9][A-Z0-9_-]{1,31}$",
                    "type": "string"
                  },
                  "description": {
                    "default": "",
                    "maxLength": 2000,
                    "type": "string"
                  },
                  "estimated_hours": {
                    "default": null,
                    "maximum": 1000,
                    "minimum": 0,
                    "nullable": true,
                    "type": "number"
                  },
                  "interval_days": {
                    "maximum": 3650,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "lead_days": {
                    "default": 3,
                    "maximum": 90,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "name": {
                    "maxLength": 200,
                    "minLength": 3,
                    "type": "string"
                  },
                  "next_due_on": {
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                    "type": "string"
                  },
                  "priority": {
                    "default": "normal",
                    "enum": [
                      "low",
                      "normal",
                      "high",
                      "urgent"
                    ],
                    "type": "string"
                  },
                  "request_type": {
                    "pattern": "^[a-z][a-z0-9-]{1,62}$",
                    "type": "string"
                  }
                },
                "required": [
                  "code",
                  "name",
                  "asset_id",
                  "request_type",
                  "interval_days",
                  "next_due_on"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Preventive plan: a work order is opened every interval_days, lead_days before it is due",
        "tags": [
          "maintenance-planning"
        ]
      }
    },
    "/planning/pm-plans/{id}": {
      "patch": {
