{
  "components": {
    "schemas": {
      "ChatRequest": {
        "properties": {
          "message": {
            "maxLength": 2000,
            "minLength": 2,
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "title": "ChatRequest",
        "type": "object"
      },
      "DocumentRequest": {
        "properties": {
          "allowed_roles": {
            "items": {
              "type": "string"
            },
            "maxItems": 15,
            "title": "Allowed Roles",
            "type": "array"
          },
          "classification": {
            "default": "internal",
            "enum": [
              "public",
              "internal",
              "restricted"
            ],
            "title": "Classification",
            "type": "string"
          },
          "content": {
            "maxLength": 200000,
            "minLength": 20,
            "title": "Content",
            "type": "string"
          },
          "source": {
            "default": "uploaded",
            "maxLength": 200,
            "title": "Source",
            "type": "string"
          },
          "title": {
            "maxLength": 200,
            "minLength": 3,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "title",
          "content"
        ],
        "title": "DocumentRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ReportRequest": {
        "properties": {
          "report_type": {
            "const": "daily_operations",
            "default": "daily_operations",
            "title": "Report Type",
            "type": "string"
          }
        },
        "title": "ReportRequest",
        "type": "object"
      },
      "ReviewRequest": {
        "properties": {
          "decision": {
            "enum": [
              "approve",
              "reject"
            ],
            "title": "Decision",
            "type": "string"
          },
          "note": {
            "anyOf": [
              {
                "maxLength": 1000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          }
        },
        "required": [
          "decision"
        ],
        "title": "ReviewRequest",
        "type": "object"
      },
      "SearchRequest": {
        "properties": {
          "limit": {
            "default": 5,
            "maximum": 8,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          },
          "query": {
            "maxLength": 300,
            "minLength": 2,
            "title": "Query",
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "title": "SearchRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Optional AI subsystem: model access, retrieval over approved documents, permission-aware read-only tools, reviewable drafts and human-approved proposals. The platform works without it.",
    "title": "TITAN ai-gateway-service",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/actions": {
      "get": {
        "operationId": "list_actions_actions_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Actions proposed by the assistant, awaiting or past human decision",
        "tags": [
          "actions"
        ]
      }
    },
