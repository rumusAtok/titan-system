            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Export a dataset (the caller's tenant only) as CSV or Parquet",
        "tags": [
          "datasets"
        ]
