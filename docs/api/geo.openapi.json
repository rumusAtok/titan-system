            "bearer": []
          }
        ],
        "tags": [
          "geospatial"
        ]
      },
      "post": {
        "operationId": "GeoController_createZone",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "code": {
                    "pattern": "^[A-Z0-9][A-Z0-9_-]{1,31}$",
                    "type": "string"
                  },
                  "description": {
                    "default": "",
                    "maxLength": 2000,
                    "type": "string"
                  },
                  "geometry": {
                    "anyOf": [
                      {
                        "properties": {
                          "coordinates": {
                            "items": {
                              "items": {
                                "items": {
                                  "anyOf": [
                                    {
                                      "maximum": 180,
                                      "minimum": -180,
                                      "type": "number"
                                    },
                                    {
                                      "maximum": 90,
                                      "minimum": -90,
                                      "type": "number"
                                    }
                                  ]
                                },
                                "maxItems": 2,
                                "minItems": 2,
                                "type": "array"
                              },
                              "maxItems": 2000,
                              "minItems": 4,
                              "type": "array"
                            },
                            "maxItems": 50,
                            "minItems": 1,
                            "type": "array"
                          },
                          "type": {
                            "enum": [
                              "Polygon"
                            ],
                            "type": "string"
                          }
                        },
                        "required": [
                          "type",
                          "coordinates"
                        ],
                        "type": "object"
                      },
                      {
                        "properties": {
                          "coordinates": {
                            "items": {
                              "items": {
                                "items": {
                                  "items": {
                                    "anyOf": [
                                      {
                                        "maximum": 180,
                                        "minimum": -180,
                                        "type": "number"
                                      },
                                      {
                                        "maximum": 90,
                                        "minimum": -90,
                                        "type": "number"
                                      }
                                    ]
                                  },
                                  "maxItems": 2,
                                  "minItems": 2,
                                  "type": "array"
                                },
                                "maxItems": 2000,
                                "minItems": 4,
                                "type": "array"
                              },
                              "maxItems": 50,
                              "minItems": 1,
                              "type": "array"
                            },
                            "maxItems": 50,
                            "minItems": 1,
                            "type": "array"
                          },
                          "type": {
                            "enum": [
                              "MultiPolygon"
                            ],
                            "type": "string"
                          }
                        },
                        "required": [
                          "type",
                          "coordinates"
                        ],
                        "type": "object"
                      }
                    ]
                  },
                  "name": {
                    "maxLength": 200,
                    "minLength": 2,
                    "type": "string"
                  },
                  "notify_role": {
                    "default": null,
                    "nullable": true,
                    "pattern": "^[a-z][a-z0-9_]{1,62}$",
                    "type": "string"
                  },
                  "watch_incidents": {
                    "default": false,
                    "type": "boolean"
                  },
                  "zone_type": {
                    "enum": [
                      "flood_zone",
                      "catchment",
                      "site_boundary",
                      "restricted_area",
                      "service_area",
                      "other"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "code",
                  "name",
                  "zone_type",
                  "geometry"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Create a zone (GeoJSON Polygon or MultiPolygon, longitude/latitude)",
        "tags": [
          "geospatial"
        ]
      }
    },
    "/zones/{id}": {
      "patch": {
        "operationId": "GeoController_updateZone",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "description": {
                    "maxLength": 2000,
                    "type": "string"
                  },
                  "expected_version": {
                    "exclusiveMinimum": true,
                    "maximum": 9007199254740991,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "geometry": {
                    "anyOf": [
                      {
                        "properties": {
                          "coordinates": {
                            "items": {
                              "items": {
                                "items": {
                                  "anyOf": [
                                    {
                                      "maximum": 180,
                                      "minimum": -180,
                                      "type": "number"
                                    },
                                    {
                                      "maximum": 90,
                                      "minimum": -90,
                                      "type": "number"
                                    }
                                  ]
                                },
                                "maxItems": 2,
                                "minItems": 2,
                                "type": "array"
                              },
                              "maxItems": 2000,
                              "minItems": 4,
                              "type": "array"
                            },
                            "maxItems": 50,
                            "minItems": 1,
                            "type": "array"
                          },
                          "type": {
                            "enum": [
                              "Polygon"
                            ],
                            "type": "string"
                          }
                        },
                        "required": [
                          "type",
                          "coordinates"
                        ],
                        "type": "object"
                      },
                      {
                        "properties": {
                          "coordinates": {
                            "items": {
                              "items": {
                                "items": {
                                  "items": {
                                    "anyOf": [
                                      {
                                        "maximum": 180,
                                        "minimum": -180,
                                        "type": "number"
                                      },
                                      {
                                        "maximum": 90,
                                        "minimum": -90,
                                        "type": "number"
                                      }
                                    ]
                                  },
                                  "maxItems": 2,
                                  "minItems": 2,
                                  "type": "array"
                                },
                                "maxItems": 2000,
                                "minItems": 4,
                                "type": "array"
                              },
                              "maxItems": 50,
                              "minItems": 1,
                              "type": "array"
                            },
                            "maxItems": 50,
                            "minItems": 1,
                            "type": "array"
                          },
                          "type": {
                            "enum": [
                              "MultiPolygon"
                            ],
                            "type": "string"
                          }
                        },
                        "required": [
                          "type",
                          "coordinates"
                        ],
                        "type": "object"
                      }
                    ]
                  },
                  "name": {
                    "maxLength": 200,
                    "minLength": 2,
                    "type": "string"
                  },
                  "notify_role": {
                    "nullable": true,
                    "pattern": "^[a-z][a-z0-9_]{1,62}$",
                    "type": "string"
                  },
                  "watch_incidents": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "expected_version"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "geospatial"
        ]
      }
    },
