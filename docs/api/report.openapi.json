{
  "components": {
    "schemas": {},
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "Report definitions over the registered analytics datasets, generated on request with the caller's access, as CSV and printable HTML; due-date reminders.",
    "title": "TITAN report-service",
    "version": "0.1.0"
  },
  "openapi": "3.0.0",
  "paths": {
    "/datasets": {
      "get": {
        "operationId": "ReportController_datasets",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Datasets a report section can use (from the analytics registry, for the caller)",
        "tags": [
          "reports"
        ]
      }
    },
    "/definitions": {
      "get": {
        "operationId": "ReportController_list",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "reports"
        ]
      },
      "post": {
        "operationId": "ReportController_create",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "description": {
                    "default": "",
                    "maxLength": 1000,
                    "type": "string"
                  },
                  "name": {
                    "maxLength": 120,
                    "minLength": 3,
                    "type": "string"
                  },
                  "notify_role": {
                    "default": null,
                    "nullable": true,
                    "pattern": "^[a-z][a-z_]{1,62}$",
                    "type": "string"
                  },
                  "schedule": {
                    "default": "none",
                    "enum": [
                      "none",
                      "daily",
                      "weekly",
                      "monthly"
                    ],
                    "type": "string"
                  },
                  "sections": {
                    "items": {
                      "properties": {
                        "dataset": {
                          "pattern": "^[a-z][a-z0-9_]{2,62}$",
                          "type": "string"
                        },
                        "filters": {
                          "additionalProperties": {
                            "anyOf": [
                              {
                                "maxLength": 200,
                                "type": "string"
                              },
                              {
                                "type": "boolean"
                              }
                            ]
                          },
                          "default": {},
                          "type": "object"
                        },
                        "limit": {
                          "default": 500,
                          "maximum": 2000,
                          "minimum": 1,
                          "type": "integer"
                        },
                        "title": {
                          "maxLength": 120,
                          "minLength": 2,
                          "type": "string"
                        }
                      },
                      "required": [
                        "title",
                        "dataset"
                      ],
                      "type": "object"
                    },
                    "maxItems": 8,
                    "minItems": 1,
                    "type": "array"
                  }
                },
                "required": [
                  "name",
                  "sections"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Define a report: up to 8 sections, each a registered dataset with optional filters; optionally a reminder schedule",
        "tags": [
          "reports"
        ]
      }
    },
