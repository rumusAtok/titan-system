                "properties": {
                  "active": {
                    "type": "boolean"
                  },
                  "description": {
                    "default": "",
                    "maxLength": 1000,
                    "type": "string"
                  },
                  "expected_version": {
                    "exclusiveMinimum": true,
                    "maximum": 9007199254740991,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "name": {
                    "maxLength": 120,
                    "minLength": 3,
                    "type": "string"
                  },
                  "notify_role": {
                    "default": null,
                    "nullable": true,
                    "pattern": "^[a-z][a-z_]{1,62}$",
                    "type": "string"
                  },
                  "schedule": {
                    "default": "none",
                    "enum": [
                      "none",
                      "daily",
                      "weekly",
                      "monthly"
                    ],
                    "type": "string"
                  },
                  "sections": {
                    "items": {
                      "properties": {
                        "dataset": {
                          "pattern": "^[a-z][a-z0-9_]{2,62}$",
                          "type": "string"
                        },
                        "filters": {
                          "additionalProperties": {
                            "anyOf": [
                              {
                                "maxLength": 200,
                                "type": "string"
                              },
                              {
                                "type": "boolean"
                              }
                            ]
                          },
                          "default": {},
                          "type": "object"
                        },
                        "limit": {
                          "default": 500,
                          "maximum": 2000,
                          "minimum": 1,
                          "type": "integer"
                        },
                        "title": {
                          "maxLength": 120,
                          "minLength": 2,
                          "type": "string"
                        }
                      },
                      "required": [
                        "title",
                        "dataset"
                      ],
                      "type": "object"
                    },
                    "maxItems": 8,
                    "minItems": 1,
                    "type": "array"
                  }
                },
                "required": [
                  "expected_version"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "reports"
        ]
      }
    },
