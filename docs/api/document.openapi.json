{
  "components": {
    "schemas": {},
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "Controlled documents: versions, malware-scan hook, review through the workflow engine, retention classes, legal hold, disposal and links to records.",
    "title": "TITAN document-service",
    "version": "0.1.0"
  },
  "openapi": "3.0.0",
  "paths": {
    "/documents": {
      "get": {
        "operationId": "DocumentController_list",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Documents the caller may read; filter by type, text, or linked record (subject_type + subject_id)",
        "tags": [
          "documents"
        ]
      },
      "post": {
        "operationId": "DocumentController_create",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "allowed_roles": {
                    "default": [],
                    "items": {
                      "pattern": "^[a-z][a-z0-9_]{1,62}$",
                      "type": "string"
                    },
                    "maxItems": 20,
                    "type": "array"
                  },
                  "change_note": {
                    "default": "",
                    "maxLength": 1000,
                    "type": "string"
                  },
                  "classification": {
                    "default": "internal",
                    "enum": [
                      "public",
                      "internal",
                      "restricted"
                    ],
                    "type": "string"
                  },
                  "content_base64": {
                    "maxLength": 7000000,
                    "minLength": 1,
                    "type": "string"
                  },
                  "content_type": {
                    "maxLength": 100,
                    "minLength": 1,
                    "type": "string"
                  },
                  "description": {
                    "default": "",
                    "maxLength": 4000,
                    "type": "string"
                  },
                  "document_type": {
                    "enum": [
                      "procedure",
                      "drawing",
                      "certificate",
                      "inspection_report",
                      "contract",
                      "manual",
                      "record",
                      "other"
                    ],
                    "type": "string"
                  },
                  "filename": {
                    "maxLength": 255,
                    "minLength": 1,
                    "type": "string"
                  },
                  "links": {
                    "default": [],
                    "items": {
                      "properties": {
                        "subject_id": {
                          "maxLength": 100,
                          "minLength": 1,
                          "type": "string"
                        },
                        "subject_type": {
                          "enum": [
                            "asset",
                            "incident",
                            "case",
                            "work_order",
                            "maintenance_request",
                            "purchase_order",
                            "site",
                            "camera"
                          ],
                          "type": "string"
                        }
                      },
                      "required": [
                        "subject_type",
                        "subject_id"
                      ],
                      "type": "object"
                    },
                    "maxItems": 20,
                    "type": "array"
                  },
                  "requires_review": {
                    "default": true,
                    "type": "boolean"
                  },
                  "retention_class": {
                    "default": "operational-3y",
                    "enum": [
                      "transitory",
                      "operational-3y",
                      "regulatory-7y",
                      "permanent"
                    ],
                    "type": "string"
                  },
                  "title": {
                    "maxLength": 200,
                    "minLength": 3,
                    "type": "string"
                  }
                },
                "required": [
                  "title",
                  "document_type",
                  "filename",
                  "content_type",
                  "content_base64"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Create a document with its first version (scanned on upload; at most 5 MB)",
        "tags": [
          "documents"
        ]
      }
    },
    "/documents/summary": {
      "get": {
        "operationId": "DocumentController_summary",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "documents"
        ]
      }
    },
    "/documents/{id}": {
      "get": {
        "operationId": "DocumentController_get",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "documents"
        ]
      }
    },
    "/documents/{id}/dispose": {
      "post": {
        "operationId": "DocumentController_dispose",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Dispose of a document whose retention has expired and which is not on legal hold. Content is removed; metadata is kept",
        "tags": [
          "documents"
        ]
      }
    },
    "/documents/{id}/legal-hold": {
      "post": {
        "operationId": "DocumentController_legalHold",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "legal_hold": {
                    "type": "boolean"
                  },
                  "reason": {
                    "maxLength": 500,
                    "minLength": 3,
                    "type": "string"
                  }
                },
                "required": [
                  "legal_hold",
                  "reason"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Place or release a legal hold (blocks disposal)",
        "tags": [
          "documents"
        ]
      }
    },
    "/documents/{id}/links": {
      "post": {
        "operationId": "DocumentController_addLink",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "subject_id": {
                    "maxLength": 100,
                    "minLength": 1,
                    "type": "string"
                  },
                  "subject_type": {
                    "enum": [
                      "asset",
                      "incident",
                      "case",
                      "work_order",
                      "maintenance_request",
                      "purchase_order",
                      "site",
                      "camera"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "subject_type",
                  "subject_id"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "documents"
        ]
      }
    },
    "/documents/{id}/links/{subjectType}/{subjectId}": {
      "delete": {
        "operationId": "DocumentController_removeLink",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "documents"
        ]
      }
    },
    "/documents/{id}/versions": {
      "post": {
        "operationId": "DocumentController_addVersion",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "change_note": {
                    "default": "",
                    "maxLength": 1000,
                    "type": "string"
                  },
                  "content_base64": {
                    "maxLength": 7000000,
                    "minLength": 1,
                    "type": "string"
                  },
                  "content_type": {
                    "maxLength": 100,
                    "minLength": 1,
                    "type": "string"
                  },
                  "filename": {
                    "maxLength": 255,
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "filename",
                  "content_type",
                  "content_base64"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Upload a new version (a draft until submitted)",
        "tags": [
          "documents"
        ]
      }
    },
    "/documents/{id}/versions/{version}/content": {
      "get": {
        "operationId": "DocumentController_content",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Download a version (always as an attachment)",
        "tags": [
          "documents"
        ]
      }
    },
    "/documents/{id}/versions/{version}/submit": {
      "post": {
        "operationId": "DocumentController_submit",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Submit a draft for review (document-review workflow), or publish it directly when the document needs no review (records managers)",
        "tags": [
          "documents"
        ]
      }
    },
    "/retention-classes": {
      "get": {
        "operationId": "DocumentController_retentionClasses",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Retention classes and their periods (illustrative defaults, not legal advice)",
        "tags": [
          "documents"
        ]
      }
    },
    "/versions/{id}": {
      "get": {
        "operationId": "DocumentController_byVersion",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Which document (and version number) a version id belongs to",
        "tags": [
          "documents"
        ]
      }
    }
  },
  "security": [
    {
      "bearer": []
    }
  ],
  "servers": [],
  "tags": []
}
