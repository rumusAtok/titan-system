                          "type": "object"
                        },
                        "type": "array"
                      },
                      "format": {
                        "enum": [
                          "titan-pack-configuration/1"
                        ],
                        "type": "string"
                      },
                      "packs": {
                        "items": {
                          "properties": {
                            "config": {
                              "additionalProperties": {},
                              "default": {},
                              "type": "object"
                            },
                            "pack_id": {
                              "type": "string"
                            },
                            "status": {
                              "enum": [
                                "active",
                                "disabled"
                              ],
                              "type": "string"
                            },
                            "version": {
                              "pattern": "^\\d+\\.\\d+\\.\\d+$",
                              "type": "string"
                            }
                          },
                          "required": [
                            "pack_id",
                            "version",
                            "status"
                          ],
                          "type": "object"
                        },
                        "type": "array"
                      }
                    },
                    "required": [
                      "format",
                      "packs"
                    ],
                    "type": "object"
                  },
                  "dry_run": {
                    "default": false,
                    "type": "boolean"
                  }
                },
                "required": [
                  "document"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Restore pack configuration from an export (always into the caller's own tenant); supports dry_run",
        "tags": [
          "industry packs"
        ]
      }
