    "/packs/import": {
      "post": {
        "operationId": "PacksController_import",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "document": {
                    "properties": {
                      "dashboard_layouts": {
                        "default": [],
                        "items": {
                          "properties": {
                            "dashboard_key": {
                              "type": "string"
                            },
                            "widgets": {
