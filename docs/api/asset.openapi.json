  "paths": {
    "/assets": {
      "get": {
        "operationId": "AssetController_list",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "assets"
        ]
      },
      "post": {
        "operationId": "AssetController_create",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "attributes": {
                    "additionalProperties": {},
                    "default": {},
                    "type": "object"
                  },
                  "category_code": {
                    "maxLength": 32,
                    "minLength": 2,
                    "type": "string"
                  },
                  "code": {
                    "maxLength": 64,
                    "minLength": 2,
                    "type": "string"
                  },
                  "commissioned_on": {
                    "default": null,
                    "format": "date",
                    "nullable": true,
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
                    "type": "string"
                  },
                  "condition": {
                    "default": "good",
                    "enum": [
                      "good",
                      "fair",
                      "poor",
                      "critical"
                    ],
                    "type": "string"
                  },
                  "latitude": {
                    "default": null,
                    "maximum": 90,
                    "minimum": -90,
                    "nullable": true,
                    "type": "number"
                  },
                  "longitude": {
                    "default": null,
                    "maximum": 180,
                    "minimum": -180,
                    "nullable": true,
                    "type": "number"
                  },
                  "name": {
                    "maxLength": 200,
                    "minLength": 2,
                    "type": "string"
                  },
                  "next_maintenance_due": {
                    "default": null,
                    "format": "date-time",
                    "nullable": true,
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                    "type": "string"
                  },
                  "parent_id": {
                    "default": null,
                    "format": "uuid",
                    "nullable": true,
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                    "type": "string"
                  },
                  "status": {
                    "default": "planned",
                    "enum": [
                      "planned",
                      "active",
                      "under_maintenance",
                      "retired"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "code",
                  "name",
                  "category_code"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "assets"
        ]
      }
    },
