        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Move the asset through its lifecycle (planned, active, under_maintenance, retired)",
        "tags": [
          "assets"
        ]
      }
    },
