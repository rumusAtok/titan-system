{
  "realm": "titan",
  "displayName": "TITAN Platform (development realm)",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 10,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 3600,
  "ssoSessionMaxLifespan": 36000,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "roles": {
    "realm": [
      {
        "name": "applicant",
        "description": "Member of the public who submits and tracks applications"
      },
      {
        "name": "validation_officer",
        "description": "Checks submitted applications for completeness"
      },
      {
        "name": "technical_officer",
        "description": "Performs the technical assessment of an application"
      },
      {
        "name": "department_head",
        "description": "Endorses applications on behalf of the department"
      },
      {
        "name": "final_approver",
        "description": "Issues the final decision on an application"
      },
      {
        "name": "duty_officer",
        "description": "Acknowledges and triages operational incidents"
      },
      {
        "name": "incident_commander",
        "description": "Directs incident response and resolves incidents"
      },
      {
        "name": "asset_manager",
        "description": "Maintains the infrastructure asset register"
      },
      {
        "name": "iot_operator",
        "description": "Manages IoT devices, alert rules and telemetry"
      },
      {
        "name": "analyst",
        "description": "Reads analytical datasets and reports"
      },
      {
        "name": "auditor",
        "description": "Reads audit records"
      },
      {
        "name": "tenant_admin",
        "description": "Administers one tenant (organisation)"
      },
      {
        "name": "dr_operator",
        "description": "Authorised to operate disaster-recovery controls"
      },
      {
        "name": "platform_admin",
        "description": "Administers the platform across tenants"
      },
      {
        "name": "service",
        "description": "Machine identity for service-to-service calls"
      }
    ]
  },
  "clients": [
    {
      "clientId": "titan-web",
      "name": "TITAN web command center",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "rootUrl": "${TITAN_WEB_ORIGIN}",
      "redirectUris": [
        "${TITAN_WEB_ORIGIN}/*"
      ],
      "webOrigins": [
        "${TITAN_WEB_ORIGIN}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${TITAN_WEB_ORIGIN}/*"
      },
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "department",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "department",
            "claim.name": "department",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "titan-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "titan-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "titan-cli",
      "name": "TITAN test and automation client",
      "description": "DEVELOPMENT/TEST ONLY: allows the password grant for automated tests and seed scripts. Remove in production.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "department",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "department",
            "claim.name": "department",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "titan-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "titan-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "svc-pipeline",
      "name": "svc-pipeline",
      "description": "data-pipeline-service machine identity",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${SVC_PIPELINE_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "titan-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "titan-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "svc-ai",
      "name": "svc-ai",
      "description": "ai-gateway-service machine identity",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${SVC_AI_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "titan-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "titan-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
