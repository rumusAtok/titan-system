# TITAN local development environment.
# Copy to .env (scripts/setup.ps1 does this). Every value here is a
# DEVELOPMENT-ONLY default. Never reuse these values outside a local machine.

COMPOSE_PROJECT_NAME=titan

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=dev_superuser_change_me
# Per-role passwords are derived as "<DB_DEV_PASSWORD>_<role name>".
# Must be URL-safe (letters, digits, underscore).
DB_DEV_PASSWORD=dev_titan_db
POSTGRES_HOST_PORT=5432

# --- Keycloak ---------------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=dev_keycloak_admin_change_me
KEYCLOAK_HOST_PORT=8081
# Public URL of the identity provider as seen by browsers and test clients.
KEYCLOAK_PUBLIC_URL=http://localhost:8081
# Client secrets for machine identities (client-credentials flow).
SVC_PIPELINE_CLIENT_SECRET=dev_svc_pipeline_secret
SVC_AI_CLIENT_SECRET=dev_svc_ai_secret

# --- Edge -------------------------------------------------------------------
GATEWAY_HOST_PORT=8080
WEB_HOST_PORT=3000
WEB_ORIGIN=http://localhost:3000
RATE_LIMIT_PER_MINUTE=600
# Background tiles of the map page. Empty = the public OpenStreetMap tile server, which each
# viewer's browser contacts directly. Use your own raster tile template, or "none" to draw the
# map without any request leaving the platform.
MAP_TILE_URL=

# --- Messaging --------------------------------------------------------------
NATS_HOST_PORT=4222
NATS_MONITOR_HOST_PORT=8222
MQTT_HOST_PORT=1883
MQTT_SIMULATOR_USER=simulator
MQTT_SIMULATOR_PASSWORD=dev_simulator_mqtt
MQTT_TELEMETRY_USER=telemetry-service
MQTT_TELEMETRY_PASSWORD=dev_telemetry_mqtt

# --- AI (optional subsystem) ------------------------------------------------
# The platform starts and works with AI disabled or with no model installed.
AI_ENABLED=true
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=llama3.2:1b
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Observability ----------------------------------------------------------
LOG_LEVEL=info
GRAFANA_HOST_PORT=3001
GRAFANA_ADMIN_PASSWORD=dev_grafana_admin
PROMETHEUS_HOST_PORT=9090

# --- Demo identities (synthetic, test-only) ---------------------------------
# Password shared by every synthetic demo user in the development realm.
DEMO_USER_PASSWORD=Titan-Demo-2026
POSTGRES_DR_HOST_PORT=5433
